# =============================================================
# CDC Lakehouse Platform — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cdc_source
POSTGRES_USER=cdc_user
POSTGRES_PASSWORD=change_me_secure_password

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_AUTO_CREATE_TOPICS=false
KAFKA_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=3

# ── Debezium ──────────────────────────────────────────────────
DEBEZIUM_CONNECTOR_HOST=debezium:8083
DEBEZIUM_CONNECTOR_NAME=postgres-cdc-connector

# ── MinIO (S3-compatible storage) ────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET_BRONZE=lakehouse-bronze
MINIO_BUCKET_SILVER=lakehouse-silver
MINIO_BUCKET_GOLD=lakehouse-gold

# ── Apache Spark ──────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# ── Apache Iceberg ────────────────────────────────────────────
ICEBERG_CATALOG_NAME=lakehouse
ICEBERG_WAREHOUSE_PATH=s3a://lakehouse-bronze/warehouse

# ── Trino ─────────────────────────────────────────────────────
TRINO_HOST=trino
TRINO_PORT=8090
TRINO_CATALOG=iceberg
TRINO_SCHEMA=default

# ── Apache Superset ───────────────────────────────────────────
SUPERSET_SECRET_KEY=change_me_superset_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_admin_pass
SUPERSET_ADMIN_EMAIL=admin@example.com
