# =============================================================
#  CDC BIG DATA PLATFORM — Environment Variables
#  Copy this file to .env and fill in your values
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# ── Debezium ──────────────────────────────────────────────────
DEBEZIUM_CONNECTOR_NAME=

# ── MinIO (S3-Compatible Storage) ─────────────────────────────
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_BRONZE=
MINIO_BUCKET_SILVER=
MINIO_BUCKET_GOLD=

# ── Apache Spark ──────────────────────────────────────────────
SPARK_MASTER_URL=
SPARK_DRIVER_MEMORY=
SPARK_EXECUTOR_MEMORY=

# ── Apache Iceberg ────────────────────────────────────────────
ICEBERG_CATALOG_NAME=
ICEBERG_WAREHOUSE_PATH=

# ── Trino ─────────────────────────────────────────────────────
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=

# ── Apache Superset ───────────────────────────────────────────
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASSWORD=
